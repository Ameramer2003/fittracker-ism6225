@{
    ViewData["Title"] = "Exercise Library";
}

@section Styles {
<style>
  .cat-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .cat-pill {
    background: var(--card); border: 1px solid var(--border);
    color: var(--muted); padding: 6px 16px; border-radius: 50px;
    font-size: 0.8rem; font-weight: 600; letter-spacing: 1px; cursor: pointer;
    transition: all 0.2s;
  }
  .cat-pill:hover { border-color: var(--green); color: var(--green); }
  .cat-pill.active { background: var(--green); border-color: var(--green); color: #0a0f0c; }
  .ex-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px; margin-bottom: 32px;
  }
  .ex-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 20px;
    display: flex; flex-direction: column; gap: 8px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .ex-card:hover { border-color: var(--green); transform: translateY(-2px); }
  .ex-card-name { font-weight: 700; font-size: 1rem; color: var(--white); }
  .ex-card-cat {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--green); background: rgba(0,230,118,0.1);
    display: inline-block; padding: 3px 10px; border-radius: 50px;
  }
  .ex-card-meta { font-size: 0.82rem; color: var(--muted); margin-top: 4px; }
  .ex-meta-row { margin-bottom: 4px; }
  .ex-card-desc {
    font-size: 0.82rem; color: var(--muted); line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
    overflow: hidden; flex: 1;
  }
  .ex-card-footer { margin-top: auto; padding-top: 12px; }
  .skeleton-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 20px;
  }
  .skeleton {
    background: linear-gradient(90deg, #1a211e 25%, #222e29 50%, #1a211e 75%);
    background-size: 200% 100%;
    animation: shimmer 1.4s infinite;
    border-radius: 6px; margin-bottom: 10px;
  }
  @@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
  .load-more-wrap { text-align: center; margin: 24px 0 8px; }
  .empty-state { text-align: center; padding: 60px 20px; grid-column: 1 / -1; }
  .empty-state .big-icon { font-size: 3rem; margin-bottom: 16px; }
  .empty-state h3 { font-size: 1.2rem; color: var(--white); margin-bottom: 8px; }
  .empty-state p { color: var(--muted); font-size: 0.9rem; }
</style>
}

<div class="page-header">
    <span class="pill pill-blue">LIVE API</span>
    <h2 style="margin-top:12px;">Exercise Library</h2>
    <p>Exercises fetched live from the <strong style="color:var(--white);">wger REST API</strong> (wger.de). Filter by category, search by name, and add any exercise directly to your workout log.</p>
</div>

<div class="section">

    <div class="alert alert-info" style="margin-bottom:32px;">
        <span>&#127760;</span>
        <div style="font-size:0.85rem;">
            <strong>Live Data from wger.de</strong><br>
            This page uses <code>fetch()</code> to call <code>https://wger.de/api/v2/</code> in real-time. No API key required. Exercises update from the live database on every page load.
        </div>
    </div>

    <div style="display:flex; gap:12px; margin-bottom:20px; flex-wrap:wrap; align-items:center;">
        <input type="text" class="form-control" id="search-input" placeholder="&#128269;  Search exercises..." style="flex:1; min-width:200px;" oninput="applySearch()" />
        <span id="result-count" style="font-size:0.82rem; color:var(--muted); white-space:nowrap;"></span>
    </div>

    <div class="cat-filters" id="cat-filters">
        <button class="cat-pill active" onclick="filterByCategory(null, this)">All</button>
    </div>

    <div class="ex-grid" id="ex-grid">
        <div class="skeleton-card" id="sk1">
            <div class="skeleton" style="height:18px; width:70%;"></div>
            <div class="skeleton" style="height:12px; width:40%;"></div>
            <div class="skeleton" style="height:60px; width:100%;"></div>
        </div>
        <div class="skeleton-card" id="sk2">
            <div class="skeleton" style="height:18px; width:60%;"></div>
            <div class="skeleton" style="height:12px; width:35%;"></div>
            <div class="skeleton" style="height:60px; width:100%;"></div>
        </div>
        <div class="skeleton-card" id="sk3">
            <div class="skeleton" style="height:18px; width:75%;"></div>
            <div class="skeleton" style="height:12px; width:45%;"></div>
            <div class="skeleton" style="height:60px; width:100%;"></div>
        </div>
        <div class="skeleton-card" id="sk4">
            <div class="skeleton" style="height:18px; width:55%;"></div>
            <div class="skeleton" style="height:12px; width:38%;"></div>
            <div class="skeleton" style="height:60px; width:100%;"></div>
        </div>
    </div>

    <div class="load-more-wrap" id="load-more-wrap" style="display:none;">
        <button class="btn btn-outline" id="load-more-btn" onclick="loadMore()">Load More Exercises &#8595;</button>
    </div>

    <div id="error-state" style="display:none;" class="empty-state">
        <div class="big-icon">&#9888;&#65039;</div>
        <h3>Could Not Load Exercises</h3>
        <p>The wger API may be temporarily unavailable. Please try refreshing the page.</p>
        <button class="btn btn-primary" style="margin-top:16px;" onclick="initPage()">&#8635; Try Again</button>
    </div>

</div>

@section Scripts {
<script src="~/js/apiController.js"></script>
<script>
    let allExercises  = [];
    let currentOffset = 0;
    let currentCatId  = null;
    let hasMore       = false;

    const CAT_MAP = {
        'Abs': 'Core', 'Arms': 'Arms', 'Back': 'Back',
        'Calves': 'Legs', 'Chest': 'Chest', 'Legs': 'Legs', 'Shoulders': 'Shoulders',
    };

    function clearSkeletons() {
        ['sk1','sk2','sk3','sk4'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.remove();
        });
    }

    function buildCard(ex) {
        const mappedCat = CAT_MAP[ex.category] || 'Full Body';
        const addUrl = `/Workout/Create?exercise=${encodeURIComponent(ex.name)}&category=${encodeURIComponent(mappedCat)}`;
        return `
            <div class="ex-card">
                <div class="ex-card-name">${ex.name}</div>
                <span class="ex-card-cat">${ex.category}</span>
                <div class="ex-card-meta">
                    <div class="ex-meta-row">&#128170; <strong>Muscles:</strong> ${ex.muscles}</div>
                    <div class="ex-meta-row">&#9881;&#65039; <strong>Equipment:</strong> ${ex.equipment}</div>
                </div>
                ${ex.description ? `<p class="ex-card-desc">${ex.description}</p>` : ''}
                <div class="ex-card-footer">
                    <a href="${addUrl}" class="btn btn-primary" style="width:100%; justify-content:center; padding:9px 16px; font-size:0.82rem;">
                        &#10133; Add to Workout
                    </a>
                </div>
            </div>`;
    }

    function renderGrid(exercises) {
        const grid = document.getElementById('ex-grid');
        const q = document.getElementById('search-input').value.toLowerCase().trim();
        const filtered = q
            ? exercises.filter(ex =>
                ex.name.toLowerCase().includes(q) ||
                ex.muscles.toLowerCase().includes(q) ||
                ex.category.toLowerCase().includes(q))
            : exercises;

        if (filtered.length === 0) {
            grid.innerHTML = `<div class="empty-state"><div class="big-icon">&#128269;</div><h3>No exercises found</h3><p>Try a different search term or select a different category.</p></div>`;
        } else {
            grid.innerHTML = filtered.map(buildCard).join('');
        }
        document.getElementById('result-count').textContent = `${filtered.length} exercise${filtered.length !== 1 ? 's' : ''}`;
    }

    function applySearch() { renderGrid(allExercises); }

    async function filterByCategory(catId, btn) {
        document.querySelectorAll('.cat-pill').forEach(p => p.classList.remove('active'));
        if (btn) btn.classList.add('active');
        currentCatId = catId; currentOffset = 0; allExercises = [];
        document.getElementById('search-input').value = '';
        document.getElementById('load-more-wrap').style.display = 'none';
        document.getElementById('ex-grid').innerHTML = `
            <div class="skeleton-card"><div class="skeleton" style="height:18px;width:70%;"></div><div class="skeleton" style="height:60px;margin-top:12px;"></div></div>
            <div class="skeleton-card"><div class="skeleton" style="height:18px;width:60%;"></div><div class="skeleton" style="height:60px;margin-top:12px;"></div></div>
            <div class="skeleton-card"><div class="skeleton" style="height:18px;width:75%;"></div><div class="skeleton" style="height:60px;margin-top:12px;"></div></div>`;
        await fetchAndAppend();
    }

    async function fetchAndAppend() {
        try {
            const result = await ApiController.getExercises(currentCatId, currentOffset);
            allExercises  = [...allExercises, ...result.exercises];
            currentOffset = result.nextOffset;
            hasMore       = result.hasMore;
            clearSkeletons();
            renderGrid(allExercises);
            document.getElementById('load-more-wrap').style.display = hasMore ? 'block' : 'none';
        } catch (err) {
            clearSkeletons();
            document.getElementById('ex-grid').innerHTML = '';
            document.getElementById('error-state').style.display = 'block';
            console.error('API error:', err);
        }
    }

    async function loadMore() {
        const btn = document.getElementById('load-more-btn');
        btn.textContent = 'Loading...'; btn.disabled = true;
        await fetchAndAppend();
        btn.textContent = 'Load More Exercises ↓'; btn.disabled = false;
    }

    async function initPage() {
        document.getElementById('error-state').style.display = 'none';
        try {
            const cats = await ApiController.getCategories();
            const filtersDiv = document.getElementById('cat-filters');
            cats.forEach(cat => {
                const btn = document.createElement('button');
                btn.className = 'cat-pill';
                btn.textContent = cat.name;
                btn.dataset.id  = cat.id;
                btn.onclick = () => filterByCategory(cat.id, btn);
                filtersDiv.appendChild(btn);
            });
        } catch (e) { console.warn('Could not load categories:', e); }
        await fetchAndAppend();
    }

    initPage();
</script>
}
