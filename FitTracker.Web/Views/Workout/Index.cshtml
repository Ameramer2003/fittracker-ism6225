@model FitTracker.Web.Models.ViewModels.WorkoutListViewModel
@{
    ViewData["Title"] = "My Workout Log";
}

@section Styles {
<style>
  .search-bar { display: flex; gap: 12px; margin-bottom: 28px; flex-wrap: wrap; }
  .search-bar input, .search-bar select { flex-shrink: 0; }
  .search-bar input { flex: 1; min-width: 200px; }
  .table-wrapper {
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius); overflow-x: auto;
  }
  .action-btn {
    padding: 6px 14px; border-radius: 6px; font-size: 0.78rem;
    font-weight: 700; cursor: pointer; border: none; transition: all .2s;
    text-decoration: none; display: inline-block;
  }
  .action-edit {
    background: rgba(255,107,53,.12); color: var(--orange);
    border: 1px solid rgba(255,107,53,.3);
  }
  .action-edit:hover { background: var(--orange); color: #fff; }
  .action-del {
    background: rgba(255,77,77,.12); color: var(--danger);
    border: 1px solid rgba(255,77,77,.3); margin-left: 6px;
  }
  .action-del:hover { background: var(--danger); color: #fff; }
  .table-footer {
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px 20px; border-top: 1px solid var(--border); flex-wrap: wrap; gap: 10px;
  }
  .page-info { font-size: 0.82rem; color: var(--muted); }
</style>
}

<div class="page-header">
    <span class="pill" style="background:rgba(100,180,255,.15); color:#64b4ff; border:1px solid rgba(100,180,255,.3);">READ</span>
    <h2 style="margin-top:12px;">My Workout Log</h2>
    <p>All entries loaded from Azure SQL. Use search and filter to find specific sessions.</p>
</div>

<div class="section">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="margin-bottom:24px;">
            <span>&#9989;</span>
            <div>@TempData["Success"]</div>
        </div>
    }

    <a asp-controller="Home" asp-action="Index" class="back-link">Back to Home</a>

    <!-- Search & Filter -->
    <form method="get" class="search-bar">
        <input type="text" class="form-control" name="query" value="@Model.Query"
               placeholder="&#128269;  Search by exercise, category, notes..." />
        <select class="form-control" name="category" style="max-width:180px;">
            <option value="">All Categories</option>
            @foreach (var cat in FitTracker.Web.Models.ViewModels.WorkoutListViewModel.Categories)
            {
                <option value="@cat" selected="@(Model.Category == cat)">@cat</option>
            }
        </select>
        <button type="submit" class="btn btn-outline" style="padding:12px 20px;">Filter</button>
        @if (!string.IsNullOrEmpty(Model.Query) || !string.IsNullOrEmpty(Model.Category))
        {
            <a asp-controller="Workout" asp-action="Index" class="btn btn-outline" style="padding:12px 20px; border-color:var(--muted); color:var(--muted);">Clear</a>
        }
        <a asp-controller="Workout" asp-action="Create" class="btn btn-primary">&#10133; Log New</a>
    </form>

    <!-- Summary Stats -->
    <div class="grid-4" style="margin-bottom:28px;">
        <div class="card stat-box">
            <div class="stat-num">@Model.Workouts.Count</div>
            <div class="stat-label">Entries Shown</div>
        </div>
        <div class="card stat-box">
            <div class="stat-num">@Model.Workouts.Sum(w => w.Calories).ToString("N0")</div>
            <div class="stat-label">Total Calories</div>
        </div>
        <div class="card stat-box">
            <div class="stat-num">@Model.Workouts.Sum(w => w.Sets)</div>
            <div class="stat-label">Total Sets</div>
        </div>
        <div class="card stat-box">
            <div class="stat-num">@Model.Workouts.Select(w => w.Category).Distinct().Count()</div>
            <div class="stat-label">Categories</div>
        </div>
    </div>

    <!-- Table -->
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Date</th>
                    <th>Exercise</th>
                    <th>Category</th>
                    <th>Sets</th>
                    <th>Reps</th>
                    <th>Weight (lbs)</th>
                    <th>Calories</th>
                    <th>Duration</th>
                    <th>Difficulty</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Workouts.Any())
                {
                    <tr>
                        <td colspan="11" style="text-align:center; padding:56px 20px;">
                            <div style="font-size:2rem; margin-bottom:12px;">&#127947;&#65039;</div>
                            <div style="color:var(--white); font-weight:700; margin-bottom:8px;">No workouts found</div>
                            <div style="margin-bottom:20px; color:var(--muted);">Try clearing your filters or <a asp-controller="Workout" asp-action="Create" style="color:var(--green);">log your first workout</a>.</div>
                        </td>
                    </tr>
                }
                @{ int rowNum = 0; }
                @foreach (var w in Model.Workouts)
                {
                    rowNum++;
                    var diffColor = w.Difficulty == "Advanced" ? "pill-red" : w.Difficulty == "Intermediate" ? "pill-orange" : "pill-green";
                    <tr>
                        <td style="color:var(--muted);">@rowNum</td>
                        <td>@w.Date.ToString("MMM d, yyyy")</td>
                        <td style="max-width:200px; font-weight:600;">@w.Exercise</td>
                        <td><span class="pill pill-green">@w.Category</span></td>
                        <td>@w.Sets</td>
                        <td>@w.Reps</td>
                        <td>@(w.Weight == 0 ? "BW" : w.Weight.ToString("N0"))</td>
                        <td>@w.Calories</td>
                        <td>@w.Duration min</td>
                        <td><span class="pill @diffColor">@w.Difficulty</span></td>
                        <td style="white-space:nowrap;">
                            <a asp-controller="Workout" asp-action="Edit" asp-route-id="@w.Id" class="action-btn action-edit">Edit</a>
                            <a asp-controller="Workout" asp-action="Delete" asp-route-id="@w.Id" class="action-btn action-del">Del</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="table-footer">
            <span class="page-info">@Model.Workouts.Count workout@(Model.Workouts.Count != 1 ? "s" : "") shown</span>
            <a asp-controller="Workout" asp-action="Create" class="btn btn-primary" style="padding:8px 18px; font-size:0.82rem;">&#10133; Add New Workout</a>
        </div>
    </div>

</div>
